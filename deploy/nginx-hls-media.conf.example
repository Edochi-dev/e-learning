# Segmentos HLS servidos directo por nginx (Node nunca mueve bytes de video).
#
# Pegar DENTRO del bloque `server { ... }` de marisnails.academy en el nginx
# del sistema (no versionado en este repo). Antes de recargar:
#
#   1. Comprobar que nginx trae el módulo:  nginx -V 2>&1 | grep -o secure_link
#   2. Reemplazar CAMBIAR_POR_HLS_MEDIA_SECRET por el valor de HLS_MEDIA_SECRET
#      de apps/backend/.env (el mismo, byte a byte).
#   3. Ajustar la ruta de `alias` si HLS_MEDIA_DIR no es la de por defecto, y
#      verificar que el usuario de nginx (www-data) puede leerla.
#   4. sudo nginx -t && sudo systemctl reload nginx
#
# Las playlists y la llave NO pasan por aquí: van por /api/hls/ al backend,
# que es quien comprueba el token de reproducción.

location ~ ^/hls-media/(?<hls_asset>[0-9a-f-]{36})/(?<hls_rendition>[0-9]{3,4}p)/(?<hls_segment>seg_[0-9]+\.ts)$ {
    secure_link $arg_md5,$arg_expires;
    # Debe coincidir con NginxSecureLinkSigner: "<expires><assetId> <secreto>".
    secure_link_md5 "$secure_link_expires$hls_asset CAMBIAR_POR_HLS_MEDIA_SECRET";

    if ($secure_link = "")  { return 403; }
    if ($secure_link = "0") { return 410; }

    alias /home/cerberus/e-learning/apps/backend/storage/hls/$hls_asset/$hls_rendition/$hls_segment;
    default_type video/mp2t;

    # Cifrados e inmutables: el navegador puede guardarlos, pero solo él.
    add_header Cache-Control "private, max-age=86400" always;
}

# Cualquier otra cosa bajo /hls-media/ (listados, playlists, rutas inventadas).
location /hls-media/ {
    return 404;
}
