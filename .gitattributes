# Line endings: LF everywhere, in the repository and in every working copy.
#
# `eol=lf` also forces LF on checkout (Windows included), so a tool that
# rewrites a whole file in LF never turns an unrelated diff into "every line
# changed". CI rejects any text file stored with CRLF (see ci.yml).
* text=auto eol=lf

# Binarios: nunca convertir, los corrompería.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.ttf binary
*.woff binary
*.woff2 binary
