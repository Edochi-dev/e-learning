# Dependencias
node_modules/

# Builds de producción
dist/
build/

# Variables de entorno
.env

# Logs de errores
*.log

# Subidas y archivos generados en runtime.
#
# NADA de lo que escriben la app o la profesora debe versionarse: son datos de
# producción, no código. Ojo: añadir una ruta aquí NO deja de trackear lo que ya
# estaba commiteado — hay que hacer `git rm --cached` además. Comprobar con
# `git ls-files apps/backend/public/` que no queda nada dentro.
apps/backend/public/certificates/generated/
apps/backend/public/certificates/templates/
apps/backend/public/corrections/
apps/backend/public/videos/
apps/backend/public/thumbnails/

# Certificados SSL (NUNCA subir a git)
ssl/*.pem
ssl/*.key
ssl/*.crt

# Backups de base de datos
backups/

# Claude Code (configuración local)
.claude/
