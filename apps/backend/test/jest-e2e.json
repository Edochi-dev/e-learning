{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "test/tsconfig.e2e.json", "isolatedModules": false }]
  },
  "globalSetup": "<rootDir>/global-setup-e2e.ts",
  "setupFiles": ["<rootDir>/setup-e2e.ts"]
}
