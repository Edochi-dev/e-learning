# ============================================================
#  Plantilla de variables de entorno — BACKEND
# ------------------------------------------------------------
#  Copia este archivo a `.env` y rellena los valores reales:
#      cp apps/backend/.env.example apps/backend/.env
#
#  El backend valida estas variables al arrancar con un esquema
#  Joi en `src/app.module.ts`. Si falta una variable `required`
#  o no cumple el formato, NestJS se niega a arrancar (fail-fast).
#  NUNCA subas tu `.env` real a git (está en .gitignore).
# ============================================================

# ── Base de datos (requeridas) ──────────────────────────────
# El backend (TypeORM) usa estas para conectarse a PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=marisnails
DB_PASSWORD=changeme
DB_NAME=marisnails_db

# ── PostgreSQL en Docker ────────────────────────────────────
# La imagen oficial `postgres:16-alpine` del docker-compose.yml
# lee ESTAS variables (no las DB_*) para crear el usuario y la
# base la primera vez que se levanta el contenedor.
# Deben coincidir con DB_USER / DB_PASSWORD / DB_NAME de arriba.
POSTGRES_USER=marisnails
POSTGRES_PASSWORD=changeme
POSTGRES_DB=marisnails_db

# ── Autenticación JWT (requerida) ───────────────────────────
# Joi exige mínimo 32 caracteres. Genera uno fuerte con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars

# ── Servidor ────────────────────────────────────────────────
PORT=3000

# ── CORS / frontend ─────────────────────────────────────────
# Origen permitido para las peticiones del navegador.
FRONTEND_URL=http://localhost:5173

# ── Email / SMTP (OPCIONAL) ─────────────────────────────────
# Los correos se guardan en la tabla email_outbox y un worker
# los envía cada 10 s, con reintentos (1, 2, 4… min, máx. 8).
# Si NO defines SMTP_HOST, el worker los imprime en el log en
# vez de enviarlos. Útil en desarrollo. Para envío real, completa
# el grupo entero (todo o nada; el backend no arranca a medias).
#   SMTP_SECURE: 'true' para SSL directo (puerto 465),
#                'false' para STARTTLS (puerto 587).
#
# Principal: buzón notificaciones@ del hosting de correo (DonWeb).
# Usa el nombre del servidor, no mail.marisnails.academy: el
# certificado TLS es *.ferozo.com y con el otro nombre falla.
# SMTP_HOST=c274.ferozo.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=notificaciones@marisnails.academy
# SMTP_PASS=la-contraseña-del-buzón
# SMTP_FROM=Maris Nails Academy <notificaciones@marisnails.academy>
#
# Respaldo (OPCIONAL): se usa solo si el principal rechaza el
# envío. Exige que el principal esté configurado. Antes de
# activarlo, el proveedor debe estar autorizado en el DNS (el SPF
# del dominio es -all). Ejemplo con Resend: el usuario es
# literalmente "resend" y la clave es una API key.
# SMTP_FALLBACK_HOST=smtp.resend.com
# SMTP_FALLBACK_PORT=465
# SMTP_FALLBACK_SECURE=true
# SMTP_FALLBACK_USER=resend
# SMTP_FALLBACK_PASS=re_tu_api_key
# SMTP_FALLBACK_FROM=Maris Nails Academy <notificaciones@marisnails.academy>

# ── Notificaciones push / PWA (OPCIONAL) ────────────────────
# Si faltan, el push queda desactivado sin romper nada: el módulo
# comprueba que existan antes de configurar web-push.
# Genera el par UNA sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# REGLA: no cambies el par una vez en uso. Cada suscripción de
# dispositivo queda atada a la clave pública; rotarla invalida
# todas las suscripciones existentes y hay que volver a pedir
# permiso en cada teléfono.
# La privada es un SECRETO: nunca al repositorio.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contacto@marisnails.academy

# ── Streaming de video (OPCIONAL) ───────────────────────────
# Vigencia en horas de la URL firmada que reciben las alumnas.
# Por defecto 2. Subirlo alarga la ventana en que un enlace
# filtrado sigue sirviendo el video.
# VIDEO_TOKEN_EXPIRY_HOURS=2

# ── Video HLS (OPCIONAL, apagado por defecto) ───────────────
# Pipeline de video propio: ffmpeg convierte cada video a HLS
# cifrado (AES-128) en varias calidades; Node entrega playlists y
# llaves, y nginx sirve los segmentos con secure_link.
# Requiere ffmpeg instalado y el bloque de
# deploy/nginx-hls-media.conf.example en el nginx del servidor.
# HLS_ENABLED=false
# Secreto compartido con nginx (secure_link_md5). Mínimo 32
# caracteres; el MISMO valor va pegado en la config de nginx.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HLS_MEDIA_SECRET=
# Prefijo público bajo el que nginx sirve los segmentos.
# HLS_MEDIA_BASE_URL=/hls-media
# Directorios (relativos a apps/backend o absolutos). NUNCA dentro
# de public/: ServeStaticModule los expondría sin token.
# Los originales se conservan para poder recodificar. Ambos deben
# entrar en el respaldo de archivos.
# HLS_SOURCE_DIR=storage/video-sources
# HLS_MEDIA_DIR=storage/hls
# nvenc = GPU NVIDIA (producción); x264 = CPU (máquinas sin GPU).
# HLS_VIDEO_ENCODER=nvenc
# Margen de vigencia del enlace de reproducción, en minutos. Se
# suma a la duración del video para no cortar una clase larga.
# HLS_TOKEN_TTL_MINUTES=30
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ── Correcciones con audio ───────────────────────────────────
# La profesora revisa con una nota de voz (máx. 2 min). ffmpeg la
# convierte a AAC y se guarda FUERA de public/: es privada de la
# alumna y se sirve solo tras verificar que es suya (o admin).
# Se borra al vencer la matrícula, o a los 30 días si el curso no
# vence; la transcripción se conserva.
# CORRECTION_AUDIO_DIR=storage/correction-audio
#
# Transcripción automática (OPCIONAL, apagada por defecto): Whisper
# local en la GPU, el audio no sale del servidor. Requiere un
# virtualenv con faster-whisper; WHISPER_PYTHON es su intérprete:
#   python3 -m venv ~/.local/share/marisnails-whisper/venv
#   ~/.local/share/marisnails-whisper/venv/bin/pip install \
#     faster-whisper nvidia-cublas-cu12 "nvidia-cudnn-cu12==9.*"
# El primer uso descarga el modelo (~1,6 GB) a ~/.cache/huggingface.
# TRANSCRIPTION_ENABLED=false
# WHISPER_PYTHON=/home/usuario/.local/share/marisnails-whisper/venv/bin/python
# WHISPER_MODEL=large-v3-turbo
# cuda = GPU NVIDIA; cpu = mucho más lento, solo para pruebas.
# WHISPER_DEVICE=cuda
