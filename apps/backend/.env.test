# ============================================================
#  Variables de entorno — TESTS E2E (NO producción)
# ------------------------------------------------------------
#  Este archivo SÍ se versiona: no contiene secretos reales,
#  solo apunta a la base de datos EFÍMERA y desechable que
#  levanta docker-compose.test.yml (contenedor mn_postgres_test,
#  puerto 5433, datos en RAM).
#
#  El guardarraíl de src/database/typeorm.config.ts exige que,
#  en modo test, el host sea local y el nombre de la DB contenga
#  "test"/"e2e". Si cambias estos valores por los de dev/prod,
#  el backend se NEGARÁ a arrancar (protección contra borrado
#  accidental de datos reales).
# ============================================================
NODE_ENV=test

DB_HOST=localhost
DB_PORT=5433
DB_USER=test
DB_PASSWORD=test
DB_NAME=marisnails_e2e

# JWT solo para tests. Joi exige mínimo 32 caracteres.
JWT_SECRET=e2e-testing-secret-not-used-anywhere-real-0123456789

FRONTEND_URL=http://localhost:5173
