# ============================================================
#  Plantilla de variables de entorno — FRONTEND (Vite)
# ------------------------------------------------------------
#  Copia este archivo a `.env` y ajusta el valor:
#      cp apps/frontend/.env.example apps/frontend/.env
#
#  Vite SOLO expone al navegador las variables con prefijo VITE_.
#  Se leen en el código como `import.meta.env.VITE_API_URL`.
#  Recuerda: todo lo que pongas aquí viaja al cliente, así que
#  NUNCA guardes secretos en variables VITE_.
# ============================================================

# URL base del backend (REST API). En desarrollo apunta al
# servidor NestJS local; en producción, al dominio público.
VITE_API_URL=http://localhost:3000
